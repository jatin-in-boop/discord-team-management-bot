# Discord Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_DB_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres
# Alternatively, set DATABASE_URL when using Railway PostgreSQL or another
# PostgreSQL provider. SUPABASE_DB_URL takes precedence when both are set.
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database

# Bot Configuration
BOT_VERSION=1.0.0
SCHEMA_VERSION=1

# Mech Arena grounded assistant
GOOGLE_SHEET_ID=your_google_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", "...":"store this in Replit Secrets"}
GROQ_API_KEY_1=your_groq_key_1
GROQ_API_KEY_2=your_groq_key_2
GROQ_API_KEY_3=your_groq_key_3
GROQ_API_KEY_4=your_groq_key_4
GROQ_API_KEY_5=your_groq_key_5
GROQ_API_KEY_6=your_groq_key_6
MECH_ARENA_POLL_SECONDS=900
MECH_ARENA_MAX_STALE_SECONDS=86400
GROQ_MODEL=llama-3.3-70b-versatile