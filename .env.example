# Discord Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_DB_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres
# Alternatively, set DATABASE_URL when using Railway PostgreSQL or another
# PostgreSQL provider. SUPABASE_DB_URL takes precedence when both are set.
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database

# Bot Configuration
BOT_VERSION=1.0.0
SCHEMA_VERSION=1